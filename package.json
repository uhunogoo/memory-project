{
  "name": "book-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Document chunking CLI powered by officeparser",
  "bin": {
    "book-memory": "./dist/cli.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "memory": "node dist/cli.mjs"
  },
  "dependencies": {
    "officeparser": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
